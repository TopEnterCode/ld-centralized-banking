# Default credential-free mode
POC_MODE=mock

# LaunchDarkly Live Mode credentials (copy this file to .env and keep values local)
LD_SDK_KEY=
LD_CLIENT_SIDE_ID=
LD_API_ACCESS_TOKEN=
LD_PROJECT_KEY=centrailized-banking
LD_ENVIRONMENT_KEY=devolopment

# Runtime admin writes remain disabled by default
ENABLE_LD_ADMIN_CONTROLS=false
DEMO_ADMIN_PIN=

# Resilience and logging
DTM_TIMEOUT_MS=700
LOG_LEVEL=INFO
